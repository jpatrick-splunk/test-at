<?xml version="1.0" encoding="UTF-8"?>
<dashboard version="1.1">
  <label>Data Quality</label>
  <description>Reading volume, logger freshness, and sensor errors for long-format zentra:reading events.</description>
  <fieldset submitButton="false" autoRun="true">
    <input type="time" token="time" searchWhenChanged="true">
      <label>Time range</label>
      <default>
        <earliest>-7d@d</earliest>
        <latest>now</latest>
      </default>
    </input>
  </fieldset>
  <row>
    <panel>
      <single>
        <title>Indexed readings</title>
        <search>
          <query>`zentra_weather_search` | stats count</query>
          <earliest>$time.earliest$</earliest>
          <latest>$time.latest$</latest>
        </search>
      </single>
    </panel>
    <panel>
      <single>
        <title>Loggers seen</title>
        <search>
          <query>`zentra_weather_search` | stats dc(device_sn) as value</query>
          <earliest>$time.earliest$</earliest>
          <latest>$time.latest$</latest>
        </search>
      </single>
    </panel>
    <panel>
      <single>
        <title>Measurements</title>
        <search>
          <query>`zentra_weather_search` | stats dc(measurement) as value</query>
          <earliest>$time.earliest$</earliest>
          <latest>$time.latest$</latest>
        </search>
      </single>
    </panel>
    <panel>
      <single>
        <title>Readings with errors</title>
        <search>
          <query>`zentra_weather_search`
| where error_flag=true OR error_flag="true" OR error_flag=1
| stats count as value</query>
          <earliest>$time.earliest$</earliest>
          <latest>$time.latest$</latest>
        </search>
        <option name="colorMode">block</option>
        <option name="useColors">1</option>
        <option name="rangeValues">[0,1,10]</option>
        <option name="rangeColors">["0x1e7c46","0xf4b63f","0xd41e1e"]</option>
      </single>
    </panel>
  </row>
  <row>
    <panel>
      <table>
        <title>Logger freshness</title>
        <search>
          <query>`zentra_weather_search`
| stats latest(datetime) as last_datetime latest(_time) as last_seen max(mrid) as last_mrid count as readings dc(measurement) as measurements sum(eval(if(error_flag=true OR error_flag="true" OR error_flag=1,1,0))) as error_events by device_sn
| eval age_seconds = now() - last_seen
| eval stale = if(age_seconds &gt; 1800, "stale", "ok")
| sort stale, device_sn</query>
          <earliest>$time.earliest$</earliest>
          <latest>$time.latest$</latest>
        </search>
        <option name="count">20</option>
        <option name="drilldown">none</option>
      </table>
    </panel>
    <panel>
      <chart>
        <title>Reading volume by measurement</title>
        <search>
          <query>`zentra_weather_search`
| timechart span=1h count by measurement</query>
          <earliest>$time.earliest$</earliest>
          <latest>$time.latest$</latest>
        </search>
        <option name="charting.chart">line</option>
      </chart>
    </panel>
  </row>
  <row>
    <panel>
      <table>
        <title>Sensor error details</title>
        <search>
          <query>`zentra_weather_search`
| where error_flag=true OR error_flag="true" OR error_flag=1 OR isnotnull(metadata_errors)
| table datetime, device_sn, measurement, value, units, sensor_name, error_flag, error_description, metadata_errors
| sort - datetime</query>
          <earliest>$time.earliest$</earliest>
          <latest>$time.latest$</latest>
        </search>
        <option name="count">20</option>
        <option name="drilldown">none</option>
      </table>
    </panel>
    <panel>
      <table>
        <title>Coverage by measurement</title>
        <search>
          <query>`zentra_weather_search`
| stats count as samples latest(datetime) as last_datetime latest(units) as units latest(aggregation) as rollup by measurement, measurement_canonical
| sort measurement</query>
          <earliest>$time.earliest$</earliest>
          <latest>$time.latest$</latest>
        </search>
        <option name="count">50</option>
        <option name="drilldown">none</option>
      </table>
    </panel>
  </row>
</dashboard>
