<?xml version="1.0" encoding="UTF-8"?>
<dashboard version="1.1">
  <label>Logger Detail</label>
  <description>Per-logger 15-minute ZENTRA readings. datetime is the measurement time from the logger dashboard.</description>
  <fieldset submitButton="false" autoRun="true">
    <input type="time" token="time" searchWhenChanged="true">
      <label>Time range</label>
      <default>
        <earliest>-7d@d</earliest>
        <latest>now</latest>
      </default>
    </input>
    <input type="dropdown" token="device_sn" searchWhenChanged="true">
      <label>Logger serial</label>
      <choice value="z6-30302">z6-30302</choice>
      <default>z6-30302</default>
      <initialValue>z6-30302</initialValue>
      <fieldForLabel>device_sn</fieldForLabel>
      <fieldForValue>device_sn</fieldForValue>
      <search>
        <query>`zentra_weather_search` | stats count by device_sn | sort device_sn</query>
        <earliest>-30d@d</earliest>
        <latest>now</latest>
      </search>
    </input>
  </fieldset>
  <row>
    <panel>
      <single>
        <title>Logger</title>
        <search>
          <query>`zentra_weather_search` device_sn="$device_sn$"
| stats latest(device_name) as device_name latest(device_sn) as device_sn latest(sensor_name) as sensor_name
| eval value = coalesce(device_name, device_sn)." / ".coalesce(sensor_name, "unknown sensor")
| fields value</query>
          <earliest>$time.earliest$</earliest>
          <latest>$time.latest$</latest>
        </search>
      </single>
    </panel>
    <panel>
      <single>
        <title>Last measurement time</title>
        <search>
          <query>`zentra_weather_search` device_sn="$device_sn$"
| stats latest(datetime) as value
| fields value</query>
          <earliest>$time.earliest$</earliest>
          <latest>$time.latest$</latest>
        </search>
      </single>
    </panel>
    <panel>
      <single>
        <title>Battery</title>
        <search>
          <query>`zentra_canonical(battery_percent)` device_sn="$device_sn$"
| stats latest(value) as value</query>
          <earliest>$time.earliest$</earliest>
          <latest>$time.latest$</latest>
        </search>
        <option name="unit">%</option>
        <option name="rangeValues">[20,40,100]</option>
        <option name="useColors">1</option>
        <option name="rangeColors">["0xd41e1e","0xf4b63f","0x1e7c46"]</option>
      </single>
    </panel>
    <panel>
      <single>
        <title>Signal</title>
        <search>
          <query>`zentra_canonical(signal_percent)` device_sn="$device_sn$"
| stats latest(value) as value</query>
          <earliest>$time.earliest$</earliest>
          <latest>$time.latest$</latest>
        </search>
        <option name="unit">%</option>
        <option name="useColors">1</option>
        <option name="rangeValues">[20,40,100]</option>
        <option name="rangeColors">["0xd41e1e","0xf4b63f","0x1e7c46"]</option>
      </single>
    </panel>
  </row>
  <row>
    <panel>
      <chart>
        <title>Air temperature</title>
        <search>
          <query>`zentra_canonical(air_temperature)` device_sn="$device_sn$"
| timechart span=15m avg(value) as air_temperature</query>
          <earliest>$time.earliest$</earliest>
          <latest>$time.latest$</latest>
        </search>
        <option name="charting.chart">line</option>
      </chart>
    </panel>
    <panel>
      <chart>
        <title>Relative humidity</title>
        <search>
          <query>`zentra_canonical(relative_humidity)` device_sn="$device_sn$"
| timechart span=15m avg(value) as relative_humidity</query>
          <earliest>$time.earliest$</earliest>
          <latest>$time.latest$</latest>
        </search>
        <option name="charting.chart">line</option>
      </chart>
    </panel>
  </row>
  <row>
    <panel>
      <chart>
        <title>Wind speed and gust</title>
        <search>
          <query>`zentra_weather_search` device_sn="$device_sn$" measurement_canonical IN (wind_speed, gust_speed)
| eval series=if(measurement_canonical="gust_speed","gust_speed","wind_speed")
| timechart span=15m avg(value) by series</query>
          <earliest>$time.earliest$</earliest>
          <latest>$time.latest$</latest>
        </search>
        <option name="charting.chart">line</option>
      </chart>
    </panel>
    <panel>
      <chart>
        <title>Solar radiation</title>
        <search>
          <query>`zentra_canonical(solar_radiation)` device_sn="$device_sn$"
| timechart span=15m avg(value) as solar_radiation</query>
          <earliest>$time.earliest$</earliest>
          <latest>$time.latest$</latest>
        </search>
        <option name="charting.chart">area</option>
      </chart>
    </panel>
  </row>
  <row>
    <panel>
      <chart>
        <title>Precipitation (15-minute interval)</title>
        <search>
          <query>`zentra_interval_precip` device_sn="$device_sn$"
| timechart span=15m sum(value) as precipitation</query>
          <earliest>$time.earliest$</earliest>
          <latest>$time.latest$</latest>
        </search>
        <option name="charting.chart">column</option>
      </chart>
    </panel>
    <panel>
      <table>
        <title>Recent readings</title>
        <search>
          <query>`zentra_weather_search` device_sn="$device_sn$"
| table datetime, logger_day, measurement, value, units, sensor_name, error_flag
| sort - datetime
| head 200</query>
          <earliest>$time.earliest$</earliest>
          <latest>$time.latest$</latest>
        </search>
        <option name="count">20</option>
        <option name="drilldown">none</option>
      </table>
    </panel>
  </row>
</dashboard>
